   "source": [
    "# 1. 두 변수 a와 b가 있습니다.\n",
    "#   a = 15, b = 4일 때\n",
    "#   a를 b로 나눈 몫과 나머지를 출력하는 코드를 작성하세요\n",
    "\n",
    "a = 15\n",
    "b = 4\n",
    "print(f\"{a}를 {b}로 나눈 몫 : {a//b}\")\n",
    "print(f\"{a}를 {b}로 나눈 나머지 : {a%b}\")\n"
   ]

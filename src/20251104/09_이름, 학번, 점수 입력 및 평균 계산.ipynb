    "d = int(input(\"점수 2 : \"))\n",
    "print(f\"이름은 {a}, 학번은 {b}\")\n",
    "print(f\"총점 = {c+d}\")\n",
    "print(f\"{a} 학생의 평균 = {(c+d)/2}\")\n"

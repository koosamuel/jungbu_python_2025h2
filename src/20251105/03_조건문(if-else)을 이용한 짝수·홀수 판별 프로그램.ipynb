   "source": [
    "# 변수 x에 정수값을 입력받아, 짝수인지 홀수인지 판별하여,\n",
    "# 짝수이면 \"짝수\", \"감사합니다\"를 두줄로,\n",
    "# 홀수이면 \"홀수\", \"감사합니다\"를 두줄로  출력하는 코드를 작성\n",
    "\n",
    "x = int(input(\"정수값을 입력하세요 : \"))\n",
    "\n",
    "if (x%2 == 0):\n",
    "    print(\"짝수\")\n",
    "else: \n",
    "    print(\"홀수\")\n",
    "print(\"감사합니다\")\n"
   ]
  },

   "source": [
    "# 한개의 정수값을 입력받아,\n",
    "# 양수인지 음수인지 0인지 판별하여 출력하는 코드를 작성\n",
    "\n",
    "x = int(input(\"정수를 입력하세요 : \"))\n",
    "\n",
    "if (x > 0):\n",
    "    print(\"양수\")\n",
    "elif (x == 0):\n",
    "    print(\"0입니다\")\n",
    "else:\n",
    "    print(\"음수\")\n"
   ]

   "source": [
    "# 단가와 구매수량을 입력받아서, 금액을 계산하여 출력합니다.\n",
    "# 단, 금액이 100만원 이상이면 5% 할인 금액으로 계산하여\n",
    "# 출력하는 코드를 작성\n",
    "\n",
    "a = int(input(\"단가 : \"))\n",
    "b = int(input(\"구매수량 : \"))\n",
    "\n",
    "c = a * b\n",
    "if (c >= 1000000):\n",
    "    print(f\"금액 : {int(c*0.95):,}\")\n",
    "else:\n",
    "    print(f\"금액 : {c:,}\")"
   ]

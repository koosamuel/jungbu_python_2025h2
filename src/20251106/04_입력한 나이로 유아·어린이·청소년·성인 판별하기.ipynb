   "source": [
    "# 나이를 입력받아서\n",
    "# 나이가 0~5세 미만이면 유아,\n",
    "# 5~13세 이하면 어린이\n",
    "# 14~19세 이하면 청소년\n",
    "# 20세 이상이면 성인을 출력\n",
    "\n",
    "age = int(input(\"나이를 입력하세요 : \"))\n",
    "\n",
    "if (0<= age <=4):\n",
    "    print(\"유아\")\n",
    "elif (5<= age <=13):\n",
    "    print(\"어린이\")\n",
    "elif (14<= age <=19):\n",
    "    print(\"청소년\")\n",
    "else:\n",
    "    print(\"성인\")"
   ]
  },

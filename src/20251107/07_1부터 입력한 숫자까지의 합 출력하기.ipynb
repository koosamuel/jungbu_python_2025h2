   ],
   "source": [
    "# 정수 하나를 입력받아서,\n",
    "# 1부터 입력받은 정수까지 합을 구하는 코드\n",
    "\n",
    "a = int(input(\"정수 : \"))\n",
    "t = 0\n",
    "\n",
    "for i in range(1, a+1, 1):\n",
    "    t += i\n",
    "\n",
    "print(f\"1부터 {a}까지 합 : {t}\")"
   ]
  },

   "source": [
    "# 반복문 멈추기 : break\n",
    "\n",
    "total = 0\n",
    "for i in range(1, 10+1, 1):\n",
    "    total += i\n",
    "    print(f\"{i}까지의 합 : {total}\")\n",
    "    if total>30:\n",
    "        print(\"합이 30이 넘었습니다\")\n",
    "        break"
   ]

   "source": [
    "# for -> while\n",
    "\n",
    "s = 0\n",
    "for i in range(1, 100+1, 1):\n",
    "    s = s + i\n",
    "print(f\"1~100까지의 합은 {s}\")\n",
    "\n",
    "print(\"=\" * 30)\n",
    "\n",
    "s = 0\n",
    "i = 0\n",
    "while i<=100:\n",
    "    s = s + i\n",
    "    i = i +1\n",
    "print(f\"1~100까지의 합은 {s}\")\n"
   ]

     "text": [
      "정수(0을 입력하면 멈춤) :  4\n",
      "정수(0을 입력하면 멈춤) :  0\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "입력한 정수의 총합은 4\n"
     ]

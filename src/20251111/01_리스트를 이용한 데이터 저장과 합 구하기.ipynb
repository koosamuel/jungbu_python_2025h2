   "source": [
    "# 리스트(List)\n",
    "# 여러 개의 데이터들을 저장할 수 있는 자료 구조\n",
    "# 대괄호, 쉼표를 이용하여 만든다\n",
    "# 0번부터 인덱스가 시작된다\n",
    "\n",
    "hap = 0\n",
    "a = 10\n",
    "b = 20\n",
    "c = 30\n",
    "d = 40\n",
    "hap = a+b+c+d\n",
    "print(f\"4개 변수의 합 : {hap}\")\n",
    "\n",
    "print(\"=\"*25)\n",
    "\n",
    "e = [10, 20, 30, 40]\n",
    "hap1 = e[0]+e[1]+e[2]+e[3]\n",
    "print(f\"리스트 각 요소의 합 : {hap1}\")"
   ]

   ],
   "source": [
    "# for문을 이용하여 list 출력\n",
    "# print문에 \\t는 탭이 입력된다\n",
    "\n",
    "list3 = [ 1, 'a', \"abc\", [1, 2, 3]]\n",
    "for i in range (len(list3)):        # list3의 갯수\n",
    "    print(f\"파이썬\\t {i}\")\n",
    "    \n",
    "print(\"=\"*15)\n",
    "\n",
    "for i in list3:                     # list3 요소가 차례로 입력된다\n",
    "    print (i)"
   ]

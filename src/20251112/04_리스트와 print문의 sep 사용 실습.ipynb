    "# renage함수와 print문의 sep\n",
    "\n",
    "list1 = []\n",
    "\n",
    "for i in range(10,50,10):           # 50은 입력되지 않는다\n",
    "    list1.append(i)\n",
    "print(list1)\n",
    "\n",
    "print()\n",
    "\n",
    "for i in [10,20,30,40,50,60,70]:    # for문에 리스트 직접사용\n",
    "    print(\"파이썬\",i, sep=\"====\")   # 구분자가 ===="
   ]

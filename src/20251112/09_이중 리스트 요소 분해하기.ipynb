    "# 리스트 컴프리핸션\n",
    "\n",
    "list1 =[ [\"홍길동\", 100],\n",
    "         [\"김길동\", 95],\n",
    "         [\"이길동\", 88]   ]\n",
    "\n",
    "for i in list1:\n",
    "    print(i[0])\n",
    "    print(i[1])\n",
    "\n",
    "print(\"=\"*20)\n",
    "\n",
    "for x, y in list1:      # 리스트 요소가 분해되어 각각 x, y에 저장된다\n",
    "    print(x)\n",
    "    print(y)"
